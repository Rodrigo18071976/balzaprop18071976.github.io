        async function initAuthAndFirestore() {
            try {
                const initialAuthToken = typeof __initial_auth_token !== 'undefined' ? __initial_auth_token : null;
                
                if (initialAuthToken) {
                    await signInWithCustomToken(auth, initialAuthToken);
                } else {
                    await signInAnonymously(auth);
                }

                const uid = auth.currentUser ? auth.currentUser.uid : 'anon-' + Math.random().toString(36).substring(2, 7);
                window.AppState.currentUser.id = uid;

                document.getElementById('user-id-badge').textContent = uid;

                // Setup Realtime Snapshots for Shared Workspace Collections
                setupCollectionListener('properties', 'properties', INITIAL_SEED.properties);
                setupCollectionListener('tenants', 'tenants', INITIAL_SEED.tenants);
                setupCollectionListener('landlords', 'landlords', INITIAL_SEED.landlords);
                setupCollectionListener('leases', 'leases', INITIAL_SEED.leases);
                setupCollectionListener('payments', 'payments', INITIAL_SEED.payments);
                setupCollectionListener('maintenanceTickets', 'maintenance', INITIAL_SEED.maintenanceTickets);
                setupCollectionListener('activityLogs', 'activity_logs', INITIAL_SEED.activityLogs);

            } catch (err) {
                console.error("Authentication or Firestore initialization error:", err);
                document.getElementById('sync-status').textContent = 'Modo Local';
                document.getElementById('sync-status').className = 'text-[10px] font-mono text-amber-400 bg-amber-950/60 border border-amber-800/50 px-2 py-0.5 rounded-md';
                
                // Fallback to initial seeds in memory if offline
                Object.assign(window.AppState, INITIAL_SEED);
                window.updateUI();
            }
        }

        function setupCollectionListener(stateKey, collectionName, fallbackData) {
            const colRef = collection(db, 'artifacts', appId, 'public', 'data', collectionName);

            onSnapshot(colRef, (snapshot) => {
                if (snapshot.empty && fallbackData && fallbackData.length > 0) {
                    // Seed Firestore if empty
                    fallbackData.forEach(async (item) => {
                        const itemDoc = doc(db, 'artifacts', appId, 'public', 'data', collectionName, item.id || `doc-${Math.random().toString(36).substring(2,7)}`);
                        await setDoc(itemDoc, item).catch(() => {});
                    });
                } else {
                    const dataList = [];
                    snapshot.forEach(docSnap => {
                        dataList.push({ id: docSnap.id, ...docSnap.data() });
                    });
                    window.AppState[stateKey] = dataList;
                    window.updateUI();
                }
            }, (error) => {
                console.warn(`Firestore collection [${collectionName}] warning:`, error.message);
                if (!window.AppState[stateKey] || window.AppState[stateKey].length === 0) {
                    window.AppState[stateKey] = fallbackData;
                }
                window.updateUI();
            });
        }

        // Expose database helpers globally
        window.dbHelpers = {
            async saveDocument(collectionName, docId, data) {
                const user = window.AppState.currentUser;
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', collectionName, docId);
                await setDoc(docRef, data, { merge: true });
                
                // Log activity
                const actRef = doc(db, 'artifacts', appId, 'public', 'data', 'activity_logs', `act-${Date.now()}`);
                await setDoc(actRef, {
                    user: user.name,
                    action: `actualizó/creó registro en ${collectionName}`,
                    timestamp: 'Justo ahora'
                });
            },
            async deleteDocument(collectionName, docId) {
                const docRef = doc(db, 'artifacts', appId, 'public', 'data', collectionName, docId);
                await deleteDoc(docRef);
            }
        };

        window.addEventListener('DOMContentLoaded', () => {
            initAuthAndFirestore();
        });
