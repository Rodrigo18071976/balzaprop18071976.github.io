            document.getElementById('user-avatar').textContent = initials;
            document.getElementById('user-avatar').className = `w-8 h-8 rounded-lg ${color} flex items-center justify-center text-white font-bold text-xs shrink-0`;
            document.getElementById('mobile-user-name').textContent = name.split(' ')[0];

            closeModal();
            showToast(`Perfil cambiado a: ${name}`, 'info');
            window.updateUI();
        };

        const handleNewPropertySubmit = async (e) => {
            e.preventDefault();
            const newId = `PROP-${100 + window.AppState.properties.length + 1}`;
            const newProp = {
                id: newId,
                address: document.getElementById('form-prop-address').value,
                city: document.getElementById('form-prop-city').value,
                type: document.getElementById('form-prop-type').value,
                rentAmount: parseFloat(document.getElementById('form-prop-rent').value) || 0,
                status: 'Disponible',
                agent: document.getElementById('form-prop-agent').value || window.AppState.currentUser.name,
                img: 'https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?auto=format&fit=crop&q=80&w=600'
            };

            if (window.dbHelpers) {
                await window.dbHelpers.saveDocument('properties', newId, newProp);
            } else {
                window.AppState.properties.unshift(newProp);
            }

            closeModal();
            showToast('Propiedad guardada y sincronizada');
            window.updateUI();
        };

        const handleNewPaymentSubmit = async (e) => {
            e.preventDefault();
            const newId = `PAY-${Math.floor(1000 + Math.random() * 9000)}`;
            const newPay = {
                id: newId,
                date: new Date().toISOString().split('T')[0],
                tenant: document.getElementById('form-pay-tenant').value,
                property: document.getElementById('form-pay-prop').value,
                amount: parseFloat(document.getElementById('form-pay-amount').value) || 0,
                concept: document.getElementById('form-pay-concept').value,
                status: 'Pagado',
                recordedBy: window.AppState.currentUser.name
            };

            if (window.dbHelpers) {
                await window.dbHelpers.saveDocument('payments', newId, newPay);
            } else {
                window.AppState.payments.unshift(newPay);
            }

            closeModal();
            showToast('Cobro registrado en la base compartida');
            window.updateUI();
        };

        window.updateUI = () => {
            const countProp = document.getElementById('badge-properties-count');
            if (countProp) countProp.textContent = window.AppState.properties.length;

            const countTick = document.getElementById('badge-tickets-count');
            if (countTick) countTick.textContent = window.AppState.maintenanceTickets.length;

            const main = document.getElementById('main-content');
            if (!main) return;

            switch (window.AppState.currentView) {
                case 'dashboard':
                    main.innerHTML = renderDashboard();
                    initRevenueChart();
                    break;
                case 'properties':
                    main.innerHTML = renderProperties();
                    break;
                case 'tenants':
                    main.innerHTML = renderTenants();
                    break;
                case 'landlords':
                    main.innerHTML = renderLandlords();
                    break;
                case 'leases':
                    main.innerHTML = renderLeases();
                    break;
                case 'payments':
                    main.innerHTML = renderPayments();
                    break;
                case 'maintenance':
                    main.innerHTML = renderMaintenance();
                    break;
                case 'team':
                    main.innerHTML = renderTeamView();
                    break;
                case 'calculator':
                    main.innerHTML = renderCalculator();
                    break;
                default:
                    main.innerHTML = renderDashboard();
                    initRevenueChart();
            }
        };

        const navigateTo = (view) => {
            window.AppState.currentView = view;
            document.querySelectorAll('.nav-btn').forEach(btn => {
                if (btn.dataset.view === view) {
                    btn.className = 'nav-btn active flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all text-white bg-brand-600 shadow-md shadow-brand-600/20';
                } else {
                    btn.className = 'nav-btn flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium text-slate-400 hover:text-white hover:bg-slate-800/80 transition-all';
                }
            });
            window.updateUI();
        };

        const applyPropertyFilters = () => {
            const search = document.getElementById('prop-filter-search')?.value.toLowerCase() || '';
            const status = document.getElementById('prop-filter-status')?.value || 'ALL';
            const type = document.getElementById('prop-filter-type')?.value || 'ALL';

            const filtered = window.AppState.properties.filter(p => {
                const matchSearch = (p.address && p.address.toLowerCase().includes(search)) || (p.city && p.city.toLowerCase().includes(search));
                const matchStatus = status === 'ALL' || p.status === status;
                const matchType = type === 'ALL' || p.type === type;
                return matchSearch && matchStatus && matchType;
            });

            const grid = document.getElementById('properties-grid');
            if (grid) {
                if (filtered.length === 0) {
                    grid.innerHTML = `<div class="col-span-full py-12 text-center text-slate-400 font-medium text-sm">No se encontraron propiedades.</div>`;
                } else {
                    grid.innerHTML = filtered.map(generatePropertyCardHTML).join('');
                }
            }
        };

        const handleGlobalSearch = (queryStr) => {
            if (!queryStr) return;
            showToast(`Buscando "${queryStr}" en el servidor compartid...`, 'info');
        };

        const initRevenueChart = () => {
            const ctx = document.getElementById('revenueChart');
            if (!ctx) return;

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: ['Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep'],
                    datasets: [{
                        label: 'Recaudación ($)',
                        data: [1200000, 1350000, 1400000, 1600000, 1650000, 1730000],
                        borderColor: '#2563eb',
                        backgroundColor: 'rgba(37, 99, 235, 0.08)',
                        fill: true,
                        tension: 0.35,
                        borderWidth: 3,
                        pointBackgroundColor: '#2563eb',
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: {
                            grid: { color: '#f1f5f9' },
                            ticks: { callback: (val) => '$' + (val / 1000) + 'k', font: { size: 11 } }
                        },
                        x: { grid: { display: false }, ticks: { font: { size: 11 } } }
                    }
                }
            });
        };

        // Bind Window Load Handlers
        window.onload = () => {
            const mobileBtn = document.getElementById('btn-toggle-mobile-menu');
            const sidebar = document.getElementById('sidebar');
            const overlay = document.getElementById('mobile-overlay');

            const toggleMobileMenu = () => {
                sidebar.classList.toggle('hidden');
                sidebar.classList.toggle('fixed');
                sidebar.classList.toggle('inset-y-0');
                sidebar.classList.toggle('left-0');
                overlay.classList.toggle('hidden');
            };

            mobileBtn?.addEventListener('click', toggleMobileMenu);
            overlay?.addEventListener('click', toggleMobileMenu);

            document.querySelectorAll('.nav-btn').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    navigateTo(btn.dataset.view);
                    if (window.innerWidth < 768 && !overlay.classList.contains('hidden')) {
                        toggleMobileMenu();
                    }
                });
            });

            window.updateUI();
        };
    </script>
</body>
</html>
